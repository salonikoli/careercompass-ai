# ─── Auth Server Environment Variables ────────────────────────
# Copy this file to .env and fill in your values

# ── Server ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/caai_auth
# Cloud MongoDB Atlas (replace with your connection string):
# MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/caai_auth

# ── JWT ───────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_random_64_char_secret_before_production
JWT_EXPIRES_IN=7d

# ── Google OAuth ──────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here

# ── Frontend URL (for CORS) ───────────────────────────────────
CLIENT_URL=http://localhost:5173
