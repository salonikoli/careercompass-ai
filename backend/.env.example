# AI Career Intelligence System — Backend Environment Variables
# -----------------------------------------------------------
# Copy this file to .env and fill in your values.
# Never commit the actual .env file — it's in .gitignore.

# ── Groq AI API Key (required for AI features) ──
# Get yours free at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Frontend URL for CORS (optional) ──
# Set this if you deploy the frontend somewhere other than GitHub Pages
FRONTEND_URL=https://prasannaganesann.github.io

# ── Server Configuration (optional, defaults shown) ──
HOST=0.0.0.0
PORT=8000
